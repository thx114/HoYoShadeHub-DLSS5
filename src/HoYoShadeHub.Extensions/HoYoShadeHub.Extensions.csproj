<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HoYoShadeHub.Extensions</RootNamespace>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HoYoShadeHub.Core\HoYoShadeHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\catalog.builtin.json" />
    <!-- 插件（ReShade addon）汉化的内置翻译表，见 I18n/AddonLocalizer.cs -->
    <EmbeddedResource Include="Resources\i18n.builtin.json" />
  </ItemGroup>

</Project>
