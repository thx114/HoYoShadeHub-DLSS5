<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Xxmi.XxmiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:HoYoShadeHub.Features.Xxmi"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Padding="36,4,36,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="TextBlock_Title" FontSize="28" FontWeight="SemiBold" Text="模型替换" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ComboBox_Importer"
                      MinWidth="200"
                      Header="实例"
                      SelectionChanged="ComboBox_Importer_SelectionChanged" />
            <TextBox x:Name="TextBox_Instance"
                     Grid.Column="1"
                     Header="MI 目录"
                     IsReadOnly="True" />
            <Button Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Click="Button_AutoFind_Click"
                    Content="自动查找"
                    ToolTipService.ToolTip="手动指定 → %AppData%\XXMI Launcher → 开始菜单里的 XXMI 快捷方式 → 注册表卸载项 → 各盘浅层目录" />
            <Button Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Click="Button_Browse_Click"
                    Content="选择…" />
            <Button Grid.Column="4"
                    VerticalAlignment="Bottom"
                    Click="Button_OpenInstance_Click"
                    Content="打开目录" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Click="Button_LaunchXxmi_Click" Content="打开 XXMI Launcher" ToolTipService.ToolTip="模型替换的注入必须由 XXMI Launcher 驱动（它那份 d3d11.dll 是受控版），这里直接帮你把它打开" />
            <Button Click="Button_Refresh_Click" Content="刷新" />
            <Button Click="Button_OpenMods_Click" Content="打开 Mods 目录" />
            <Button Click="Button_ImportFolder_Click" Content="导入文件夹…" />
            <Button Click="Button_ImportZip_Click" Content="导入 zip…" />
            <TextBlock x:Name="TextBlock_ModsCount"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ListView x:Name="ListView_Mods" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:XxmiModItem">
                    <Border Margin="0,0,0,6"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Info}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <ToggleSwitch MinWidth="0"
                                              OffContent="禁用"
                                              OnContent="启用"
                                              IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                              Toggled="ToggleSwitch_Mod_Toggled" />
                                <Button MinWidth="0"
                                        Padding="8,3"
                                        Click="Button_OpenMod_Click"
                                        Content="打开" />
                                <Button MinWidth="0"
                                        Padding="8,3"
                                        Click="Button_DeleteMod_Click"
                                        Content="删除" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="TextBlock_Status"
                   Grid.Row="4"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</sf:PageBase>
