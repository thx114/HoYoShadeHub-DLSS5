<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Modules.ModulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:HoYoShadeHub.Features.Modules"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Padding="18,4,30,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="模块" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="这个游戏要注入哪些模块（DLSS-NR on AMD 这类），可以多选。模块的下载 / 删除 / 全局开关在左下角「全局插件 → 模块」里。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Click="Button_Refresh_Click" Content="刷新" />
            <TextBlock x:Name="TextBlock_Count"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--  统一成 ScrollViewer + ItemsControl（ListView 虽然自带滚动，但这里不需要选中，
              和 OptiScaler 页保持一套写法；模板内容一字未动）  -->
        <ScrollViewer Grid.Row="2" Padding="0,0,6,0">
            <ItemsControl x:Name="ListView_Modules">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ModuleChoiceItem">
                    <Border Margin="0,0,0,6"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind Used, Mode=TwoWay}"
                                      IsEnabled="{x:Bind CanUse}"
                                      Click="CheckBox_Module_Click" />

                            <StackPanel Grid.Column="1" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Text="{x:Bind Name}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind TagsText}" />
                                </StackPanel>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Description}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Detail}"
                                           TextWrapping="Wrap" />
                                <!--  版本 + 注入时机放同一行（注入时机按模块，和「全局插件 → 模块」共用同一个值）  -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!--  需求1：不用 Header（会占垂直空间、把这一行挤成两行），改成左边一个「版本」标签 + 无 Header 的下拉，全部居中对齐  -->
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="版本"
                                               Visibility="{x:Bind VersionPickerVisibility}" />
                                    <ComboBox MinWidth="160"
                                              VerticalAlignment="Center"
                                              ItemsSource="{x:Bind Versions}"
                                              SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}"
                                              Visibility="{x:Bind VersionPickerVisibility}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind VersionHint}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind VersionHintVisibility}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="注入时机" />
                                    <NumberBox Width="150"
                                               Minimum="0"
                                               Maximum="30"
                                               SmallChange="1"
                                               SpinButtonPlacementMode="Compact"
                                               PlaceholderText="{x:Bind InjectDelayPlaceholder, Mode=OneWay}"
                                               Value="{x:Bind InjectDelayValue, Mode=TwoWay}"
                                               ToolTipService.ToolTip="启动游戏时这个模块等几秒再注入。越早注入越省事，但游戏刚启动就注可能把它带崩；默认 0 秒（立即注入，和以前一样），调大才会等；留空 = 跟随全局。" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind InjectDelayHint}" />
                                </StackPanel>

                                <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind MissingText}"
                                           Visibility="{x:Bind MissingVisibility}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="TextBlock_Status"
                   Grid.Row="3"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>

</sf:PageBase>