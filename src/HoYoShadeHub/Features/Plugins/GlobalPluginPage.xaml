<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Plugins.GlobalPluginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:HoYoShadeHub.Features.Plugins"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Page.Resources>
        <!--  插件 / OptiScaler / 模块 三个标签页共用的一整套视觉（卡片 / 紧凑行 / 标签 chip） -->
        <Style x:Key="CatalogCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!--  「当前」卡片：直接复用上面的 CatalogCardStyle，只统一补一个最小高度，三个标签页同高 -->
        <Style x:Key="CatalogCurrentCardStyle"
               BasedOn="{StaticResource CatalogCardStyle}"
               TargetType="Border">
            <Setter Property="MinHeight" Value="60" />
        </Style>

        <Style x:Key="CatalogHeaderButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="CatalogRowButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CatalogTagBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!--  tags 的小圆角标签：三个标签页共用  -->
        <DataTemplate x:Key="CatalogTagTemplate" x:DataType="x:String">
            <Border Style="{StaticResource CatalogTagBorderStyle}">
                <TextBlock FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind}" />
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="18,4,30,12"
          RowSpacing="8"
          AllowDrop="True"
          DragOver="Grid_DragOver"
          Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题 + 操作（搜索框放在「本地安装」左边）+ 顶部状态 -->
        <StackPanel Grid.Row="0" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="0">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="全局插件" />
                    <TextBlock x:Name="TextBlock_TargetPath"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="正在检测 HoYoShade…"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="Button_Refresh" Click="Button_Refresh_Click" ToolTipService.ToolTip="重新检测">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button x:Name="Button_PickFolder" Click="Button_PickFolder_Click" Content="指定目录" />
                    <Button x:Name="Button_OpenFolder" Click="Button_OpenFolder_Click" Content="打开目录" />
                    <TextBox x:Name="TextBox_Search"
                             Width="200"
                             VerticalAlignment="Center"
                             PlaceholderText="搜索…"
                             TextChanged="TextBox_Search_TextChanged" />
                    <Button x:Name="Button_CleanStale"
                            Click="Button_CleanStaleReferences_Click"
                            Content="清理失效条目"
                            ToolTipService.ToolTip="扫一遍所有游戏的 ReShade.ini，把 DisabledAddons / LoadFromDllMain 里指向「已经不存在的插件文件」的条目删掉" />
    <Button x:Name="Button_CheckAllUpdates" Click="Button_CheckAllUpdates_Click" Content="检查全部更新" ToolTipService.ToolTip="立刻向 GitHub 强制检查一遍（平时一天只自动查一次）" />
                    <Button x:Name="Button_Dlss5CompatCheck" Click="Button_Dlss5CompatCheck_Click" Content="DLSS5 兼容性检测" Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="检测这台机器 / 这个游戏跑 DLSS5 神经渲染的 15 项兼容性" />
                    <Button x:Name="Button_InstallLocal"
                            Click="Button_InstallLocal_Click"
                            Content="本地安装…"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <!--  诊断  -->
            <InfoBar x:Name="InfoBar_Status"
                     IsClosable="True"
                     IsOpen="False"
                     Severity="Informational" />

        </StackPanel>

        <!--  一行：左边标签页，右边计数  -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  插件 / OptiScaler / 模块：三个标签页都是「上 当前、下 可下载」 -->
            <!--  放在 * 列里让这一排拿到整行可用宽度：RadioButtons 不会因为可用宽度不够而折成 2 列，
                 第三个标签就不会掉到另一个位置；三个 RadioButton 再统一 MinWidth + 左对齐 + 垂直居中，                 单选框圆圈、文字起始位置一致，整体等距排布  -->
            <RadioButtons x:Name="RadioButtons_View"
                          Grid.Column="0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          MaxColumns="3"
                          SelectedIndex="0"
                          SelectionChanged="RadioButtons_View_SelectionChanged">
                <RadioButton MinWidth="132"
                             HorizontalAlignment="Left"
                             HorizontalContentAlignment="Left"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Content="插件"
                             Tag="plugins" />
                <RadioButton MinWidth="132"
                             HorizontalAlignment="Left"
                             HorizontalContentAlignment="Left"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Content="OptiScaler"
                             Tag="optiscaler" />
                <RadioButton MinWidth="132"
                             HorizontalAlignment="Left"
                             HorizontalContentAlignment="Left"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Content="模块"
                             Tag="modules" />
            </RadioButtons>

            <TextBlock x:Name="TextBlock_Count"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="3">
            <!--  ===================== 插件 =====================  -->
            <Grid x:Name="Grid_Plugins">
                <ScrollViewer Padding="0,0,6,0">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="当前" />

                        <!--  已装的扩展包：全局开关 + 点开改版本（切到别的 tag 就是装那个版本）  -->
                        <ItemsControl x:Name="InstalledPluginList" ItemsSource="{x:Bind InstalledItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PluginItemViewModel">
                                    <Border Style="{StaticResource CatalogCurrentCardStyle}">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Click="MenuFlyout_RenamePlugin_Click" Text="重命名（显示名 / 版本号）" />
                                                <MenuFlyoutItem Click="MenuFlyout_OpenPluginFolder_Click" Text="打开所在文件夹" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Click="MenuFlyout_DeletePlugin_Click" Text="删除这个插件" />
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        MinHeight="40"
                                                        Style="{StaticResource CatalogHeaderButtonStyle}"
                                                        Click="Button_PluginHeader_Click"
                                                        ToolTipService.ToolTip="点一下展开 / 收起（展开后可换版本）">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <FontIcon VerticalAlignment="Center"
                                                                      FontSize="12"
                                                                      Glyph="{x:Bind ExpandGlyph}" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       DoubleTapped="TextBlock_PluginName_DoubleTapped"
                                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                       Text="{x:Bind Name, Mode=OneWay}"
                                                                       ToolTipService.ToolTip="双击改显示名 / 版本号；右键有更多操作" />
                                                            <Border Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    CornerRadius="3"
                                                                    ToolTipService.ToolTip="当前装着的版本"
                                                                    Visibility="{x:Bind VersionBadgeVisibility}">
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           Text="{x:Bind VersionBadgeText}" />
                                                            </Border>
                                                            <ItemsControl VerticalAlignment="Center"
                                                                          ItemTemplate="{StaticResource CatalogTagTemplate}"
                                                                          ItemsSource="{x:Bind Tags}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                            <Border Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="3"
                                                                    Visibility="{x:Bind InstalledVisibility}">
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                           Text="已安装" />
                                                            </Border>
                                                            <Border Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                    CornerRadius="3"
                                                                    Visibility="{x:Bind UpdateBadgeVisibility}">
                                                                <TextBlock FontSize="11" Text="{x:Bind UpdateBadgeText}" />
                                                            </Border>
                                                            <Border Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                                    CornerRadius="3"
                                                                    Visibility="{x:Bind DllRequiredVisibility}">
                                                                <TextBlock FontSize="11" Text="{x:Bind DllStatusText}" />
                                                            </Border>
                                                            <Border Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                    CornerRadius="3"
                                                                    Visibility="{x:Bind DllRecommendedVisibility}">
                                                                <TextBlock FontSize="11" Text="{x:Bind DllStatusText}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Text="{x:Bind SummaryText}" />
                                                    </Grid>
                                                </Button>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <ToggleSwitch MinWidth="0"
                                                                  VerticalAlignment="Center"
                                                                  IsEnabled="{x:Bind CanInteract}"
                                                                  IsOn="{x:Bind GlobalEnabled, Mode=TwoWay}"
                                                                  OffContent="全局关"
                                                                  OnContent="全局开"
                                                                  ToolTipService.ToolTip="全局开关 = 改这个插件文件名后缀（.addon64  .addon64x）"
                                                                  Visibility="{x:Bind GlobalSwitchVisibility}" />
                                                    <Button Click="Button_CheckPluginUpdate_Click" Content="检查更新" />
                                                    <Button Click="Button_Install_Click"
                                                            Content="{x:Bind ActionText}"
                                                            IsEnabled="{x:Bind CanInteract}" />
                                                </StackPanel>
                                            </Grid>

                                            <ProgressBar Height="3"
                                                         Maximum="100"
                                                         Visibility="{x:Bind BusyVisibility}"
                                                         Value="{x:Bind ProgressPercent}" />

                                            <StackPanel Spacing="6" Visibility="{x:Bind ExpandedVisibility}">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind VersionText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind DiskOnlyHint}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{x:Bind DiskOnlyHintVisibility}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind StatusText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind FilesText}"
                                                           TextWrapping="Wrap" />
                                                <!--  版本：下拉选一个装（默认选中当前装着的那个），切版本 = 重新装那个 tag  -->
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ComboBox MinWidth="200"
                                                              Header="版本"
                                                              DropDownOpened="ComboBox_PluginVersions_DropDownOpened"
                                                              ItemsSource="{x:Bind Versions}"
                                                              PlaceholderText="点开卡片时自动获取版本"
                                                              SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" />
                                                    <Button VerticalAlignment="Bottom"
                                                            Click="Button_InstallVersion_Click"
                                                            Content="切换 / 重装这个版本"
                                                            IsEnabled="{x:Bind CanInteract}" />
                                                    <Button VerticalAlignment="Bottom"
                                                            Click="Button_OpenPluginFolder_Click"
                                                            Content="打开目录" />
                                                    <Button VerticalAlignment="Bottom"
                                                            Click="Button_Uninstall_Click"
                                                            Content="删除" />
                                                </StackPanel>
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind VersionsHint}"
                                                           TextWrapping="Wrap" />
                                                <HyperlinkButton Padding="0"
                                                                 Click="Hyperlink_Homepage_Click"
                                                                 Content="{x:Bind Homepage}"
                                                                 Visibility="{x:Bind HomepageVisibility}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TextBlock_PluginsCurrentEmpty"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="插件目录里没有插件。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <!--  用户在别处拿到的、目录条目认领不到的老插件文件：单独一截，保留逐个改名开关） -->
                        <TextBlock x:Name="TextBlock_OrphanCaption"
                                   Margin="0,6,0,0"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Text="其它插件文件（目录里没匹配到条目）"
                                   Visibility="Collapsed" />

                        <ItemsControl x:Name="OrphanAddonFileList" ItemsSource="{x:Bind OrphanAddonFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:AddonFileItemViewModel">
                                    <Border Style="{StaticResource CatalogCardStyle}">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Click="MenuFlyout_RenameAddon_Click" Text="重命名（显示名 / 版本号）" />
                                                <MenuFlyoutItem Click="MenuFlyout_OpenAddonFolder_Click" Text="打开所在文件夹" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Click="MenuFlyout_DeleteAddon_Click" Text="删除这个插件" />
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock VerticalAlignment="Center"
                                                                DoubleTapped="TextBlock_AddonName_DoubleTapped"
                                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind Name, Mode=OneWay}"
                                                                ToolTipService.ToolTip="双击改显示名 / 版本号；右键有更多操作" />
                                                    <Border Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                            CornerRadius="3"
                                                            Visibility="{x:Bind DisabledVisibility}">
                                                        <TextBlock FontSize="11" Text="全局已禁用" />
                                                    </Border>
                                                    <Border Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                            CornerRadius="3"
                                                            Visibility="{x:Bind DllRequiredVisibility}">
                                                        <TextBlock FontSize="11" Text="{x:Bind DllStatusText}" />
                                                    </Border>
                                                    <Border Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                            CornerRadius="3"
                                                            Visibility="{x:Bind DllRecommendedVisibility}">
                                                        <TextBlock FontSize="11" Text="{x:Bind DllStatusText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind MetaText}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <ToggleSwitch MinWidth="0"
                                                              VerticalAlignment="Center"
                                                              IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                              OffContent="全局关"
                                                              OnContent="全局开"
                                                              ToolTipService.ToolTip="全局开关 = 改文件名后缀（.addon64  .addon64x）" />
                                                <!--  汉化 / 还原这个插件文件（已按用户要求隐藏，入口挪到设置里的实验性功能）  -->
                                                <Button MinWidth="0"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed"
                                                        Click="Button_LocalizeAddon_Click"
                                                            ToolTipService.ToolTip="用翻译表把这行插件界面里的英文文本原地换成中文">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="13" Glyph="&#xE8C1;" />
                                                        <TextBlock FontSize="12" Text="汉化" />
                                                    </StackPanel>
                                                </Button>
                                                <Button MinWidth="0"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Click="Button_RestoreAddon_Click"
                                                        Visibility="Collapsed"
                                                        ToolTipService.ToolTip="从备份还原成原版插件">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="13" Glyph="&#xE7A7;" />
                                                        <TextBlock FontSize="12" Text="还原" />
                                                    </StackPanel>
                                                </Button>
                                                <Button MinWidth="0"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Click="Button_DeleteAddonFile_Click"
                                                            ToolTipService.ToolTip="把这个插件文件从插件目录里删掉（会先弹一次确认），并清掉各游戏 ini 里指向它的条目）">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                                        <TextBlock FontSize="12" Text="删除" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,6,0,0"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Text="可下载" />

                        <!--  还没装的扩展包：紧凑一行，点开才摊描述 / 安装  -->
                        <ItemsControl x:Name="PluginList" ItemsSource="{x:Bind VisibleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PluginItemViewModel">
                                    <Border Style="{StaticResource CatalogCardStyle}">
                                        <StackPanel Spacing="6">
                                            <Button Style="{StaticResource CatalogHeaderButtonStyle}"
                                                    Click="Button_PluginHeader_Click"
                                                    ToolTipService.ToolTip="点一下展开 / 收起">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                        <FontIcon VerticalAlignment="Center"
                                                                  FontSize="12"
                                                                  Glyph="{x:Bind ExpandGlyph}" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                   Text="{x:Bind Name}" />
                                                        <ItemsControl VerticalAlignment="Center"
                                                                      ItemTemplate="{StaticResource CatalogTagTemplate}"
                                                                      ItemsSource="{x:Bind Tags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Text="{x:Bind SummaryText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <StackPanel Spacing="6" Visibility="{x:Bind ExpandedVisibility}">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind VersionText}"
                                                           TextWrapping="Wrap" />
                                                <ComboBox MinWidth="200"
                                                          Header="版本"
                                                          HorizontalAlignment="Left"
                                                          DropDownOpened="ComboBox_PluginVersions_DropDownOpened"
                                                          ItemsSource="{x:Bind Versions}"
                                                          PlaceholderText="点开卡片时自动获取版本"
                                                          SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind VersionsHint}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind StatusText}"
                                                           TextWrapping="Wrap" />
                                                <Button HorizontalAlignment="Left"
                                                        Click="Button_InstallVersion_Click"
                                                        Content="{x:Bind ActionText}"
                                                        IsEnabled="{x:Bind CanInteract}"
                                                        Style="{ThemeResource AccentButtonStyle}" />
                                                <HyperlinkButton Padding="0"
                                                                 Click="Hyperlink_Homepage_Click"
                                                                 Content="{x:Bind Homepage}"
                                                                 Visibility="{x:Bind HomepageVisibility}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TextBlock_PluginsAvailableEmpty"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="目录里的插件都已经装上了。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  ===================== OptiScaler =====================  -->
            <Grid x:Name="Grid_OptiScaler" Visibility="Collapsed">
                <ScrollViewer Padding="0,0,6,0">
                    <StackPanel Spacing="6">

                        <TextBlock Margin="0,6,0,0" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="当前" />

                        <ItemsControl x:Name="OptiScalerBuildList" ItemsSource="{x:Bind OptiScalerBuilds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:OptiScalerBuildItemViewModel">
                                    <Border Style="{StaticResource CatalogCurrentCardStyle}">
                                        <StackPanel Spacing="6">
                                            <StackPanel.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Icon="Rename" Click="MenuFlyout_RenameOptiScalerBuild_Click" Text="重命名（显示名 / 版本号）" />
                                                    <MenuFlyoutItem Icon="OpenFile" Click="MenuFlyout_OpenOptiScalerBuildFolder_Click" Text="打开目录" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Icon="Delete" Click="MenuFlyout_DeleteOptiScalerBuild_Click" Text="删除这个构建" />
                                                </MenuFlyout>
                                            </StackPanel.ContextFlyout>
                                            <!--  标题行：点一下展开 / 收起（默认只占紧凑一行）  -->
                                            <Button MinHeight="40"
                                                    Style="{StaticResource CatalogHeaderButtonStyle}"
                                                    Click="Button_OptiScalerHeader_Click"
                                                    ToolTipService.ToolTip="点一下展开 / 收起（展开后可换版本）">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                        <FontIcon VerticalAlignment="Center"
                                                                  FontSize="12"
                                                                  Glyph="{x:Bind ExpandGlyph}" />
                                                        <TextBlock VerticalAlignment="Center"
                                                        DoubleTapped="TextBlock_OptiScalerName_DoubleTapped"
                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                        ToolTipService.ToolTip="双击改显示名 / 版本号；右键有更多操作" />
                                                        <Border Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="3"
                                                                ToolTipService.ToolTip="构建版本"
                                                                Visibility="{x:Bind VersionBadgeVisibility}">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       Text="{x:Bind VersionBadgeText}" />
                                                        </Border>
                                                        <ItemsControl VerticalAlignment="Center"
                                                                      ItemTemplate="{StaticResource CatalogTagTemplate}"
                                                                      ItemsSource="{x:Bind CatalogTags, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                        <Border Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="3"
                                                                Visibility="{x:Bind EnabledVisibility}">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                       Text="使用中" />
                                                        </Border>
                                                        <Border Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                                CornerRadius="3"
                                                                Visibility="{x:Bind NoDllVisibility}">
                                                            <TextBlock FontSize="11" Text="包里找到 OptiScaler.dll" />
                                                        </Border>
                                                        <Border Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                CornerRadius="3"
                                                                Visibility="{x:Bind MissingNrdllVisibility}">
                                                            <TextBlock FontSize="11" Text="缺 nvngx_dlssnr.dll" />
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Text="{x:Bind SummaryText}" />
                                                        <ToggleSwitch MinWidth="0"
                                                                      VerticalAlignment="Center"
                                                                      IsOn="{x:Bind IsGloballyEnabled, Mode=TwoWay}"
                                                                      OffContent="全局关"
                                                                      OnContent="全局开"
                                                                      Toggled="ToggleSwitch_OptiScalerBuildEnabled_Toggled"
                                                                      ToolTipService.ToolTip="每个构建自己的全局开关：关掉后哪个游戏都用不了这个构建（启动时不注入）" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!--  展开后：元信息 + 换版本 + 目录 / 删除 / nrdll  -->
                                            <StackPanel Spacing="6" Visibility="{x:Bind ExpandedVisibility}">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind MetaText}"
                                                           TextWrapping="Wrap" />

                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8"
                                                            Visibility="{x:Bind VersionSwitchVisibility}">
                                                    <ComboBox MinWidth="220"
                                                              Header="版本"
                                                              DropDownOpened="ComboBox_OptiScalerVersions_DropDownOpened"
                                                              ItemsSource="{x:Bind Versions}"
                                                              PlaceholderText="点开下拉自动获取版本"
                                                              SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" />
                                                    <Button VerticalAlignment="Bottom"
                                                            Click="Button_DownloadOptiScaler_Click"
                                                            Content="{x:Bind ActionText}"
                                                            IsEnabled="{x:Bind CanInteract}"
                                                            Style="{ThemeResource AccentButtonStyle}" />
                                                </StackPanel>

                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind StatusText}"
                                                           TextWrapping="Wrap" />

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Click="Button_PlaceOptiScalerNrdll_Click"
                                                            Content="放入 nvngx_dlssnr.dll"
                                                            ToolTipService.ToolTip="各分支手册都要求把 nvngx_dlssnr.dll 放在包旁边。这里从「DLL 配置」装好的插件目录复制一份到构建目录"
                                                            Visibility="{x:Bind MissingNrdllVisibility}" />
                                                    <Button Click="Button_CheckOptiScalerUpdate_Click" Content="检查更新" />
                                                    <Button Click="Button_OpenOptiScalerBuild_Click"
                                                            Content="打开目录"
                                                            IsEnabled="{x:Bind CanOpenFolder}" />
                                                    <Button Click="Button_DeleteOptiScalerBuild_Click" Content="删除" />
                                                </StackPanel>

                                                <HyperlinkButton Padding="0"
                                                                 Click="Hyperlink_OptiScalerRepo_Click"
                                                                 Content="{x:Bind CatalogRepository, Mode=OneWay}"
                                                                 Visibility="{x:Bind RepoVisibility}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TextBlock_OptiScalerCurrentEmpty"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="还没有下载任何 OptiScaler。先在下面「可下载」里拉一个。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <TextBlock Margin="0,6,0,0"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Text="可下载" />

                        <ItemsControl x:Name="OptiScalerSourceList" ItemsSource="{x:Bind OptiScalerSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:OptiScalerSourceItemViewModel">
                                    <Border Style="{StaticResource CatalogCardStyle}">
                                        <StackPanel Spacing="6">
                                            <!--  标题行：点一下展开 / 收起（默认只占紧凑一行）  -->
                                            <Button Style="{StaticResource CatalogHeaderButtonStyle}"
                                                    Click="Button_OptiScalerHeader_Click"
                                                    ToolTipService.ToolTip="点一下展开 / 收起">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                        <FontIcon VerticalAlignment="Center"
                                                                  FontSize="12"
                                                                  Glyph="{x:Bind ExpandGlyph}" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                   Text="{x:Bind Name}" />
                                                        <ItemsControl VerticalAlignment="Center"
                                                                      ItemTemplate="{StaticResource CatalogTagTemplate}"
                                                                      ItemsSource="{x:Bind Tags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Text="{x:Bind SummaryText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!--  展开后才是完整的可下载卡片  -->
                                            <StackPanel Spacing="6" Visibility="{x:Bind ExpandedVisibility}">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind Description}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ComboBox MinWidth="220"
                                                              Header="版本"
                                                              DropDownOpened="ComboBox_OptiScalerVersions_DropDownOpened"
                                                              ItemsSource="{x:Bind Versions}"
                                                              PlaceholderText="点开下拉自动获取版本"
                                                              SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" />
                                                    <Button VerticalAlignment="Bottom"
                                                            Click="Button_DownloadOptiScaler_Click"
                                                            Content="{x:Bind ActionText}"
                                                            IsEnabled="{x:Bind CanInteract}"
                                                            Style="{ThemeResource AccentButtonStyle}" />
                                                </StackPanel>
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind StatusText}"
                                                           TextWrapping="Wrap" />
                                                <HyperlinkButton Padding="0"
                                                                 Click="Hyperlink_OptiScalerRepo_Click"
                                                                 Content="{x:Bind Repository}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TextBlock_OptiScalerAvailableEmpty"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="可下载的来源都已经装过一份了。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  ===================== 模块 =====================  -->
            <Grid x:Name="Grid_Modules" Visibility="Collapsed">
                <ScrollViewer Padding="0,0,6,0">
                    <StackPanel Spacing="6">
                        <!--  顶部按钮：添加 DLL / 打开模块目录 / 刷新  -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="Button_AddModuleDll_Click"
                                    Content="添加 DLL…"
                                    ToolTipService.ToolTip="手动加一个要注入的 DLL（内置模块表里没有的）" />
                            <Button Click="Button_OpenModulesFolder_Click"
                                    Content="打开模块目录"
                                    ToolTipService.ToolTip="打开 &lt;用户数据目录&gt;\Modules" />
                            <Button Click="Button_RefreshModules_Click" Content="刷新" />
                        </StackPanel>

                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="当前" />

                        <ItemsControl x:Name="ModuleList" ItemsSource="{x:Bind CurrentModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ModuleItemViewModel">
                                    <Border Style="{StaticResource CatalogCurrentCardStyle}">
                                        <StackPanel Spacing="6">
                                    <StackPanel.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Icon="Rename" Click="MenuFlyout_RenameModule_Click" Text="重命名（显示名 / 版本号）" />
                                            <MenuFlyoutItem Icon="OpenFile" Click="MenuFlyout_OpenModuleFolder_Click" Text="打开目录" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Icon="Delete" Click="MenuFlyout_DeleteModule_Click" Text="删除这个模块" />
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        MinHeight="40"
                                                        Style="{StaticResource CatalogHeaderButtonStyle}"
                                                        Click="Button_ModuleHeader_Click"
                                                        ToolTipService.ToolTip="点一下展开 / 收起">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <FontIcon VerticalAlignment="Center"
                                                                      FontSize="12"
                                                                      Glyph="{x:Bind ExpandGlyph}" />
                                                            <TextBlock VerticalAlignment="Center"
                                                            DoubleTapped="TextBlock_ModuleName_DoubleTapped"
                                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                ToolTipService.ToolTip="双击改显示名 / 版本号；右键有更多操作" />
                                                            <Border Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    CornerRadius="3"
                                                                    ToolTipService.ToolTip="模块版本"
                                                                    Visibility="{x:Bind VersionBadgeVisibility}">
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           Text="{x:Bind VersionBadgeText}" />
                                                            </Border>
                                                            <ItemsControl VerticalAlignment="Center"
                                                                          ItemTemplate="{StaticResource CatalogTagTemplate}"
                                                                          ItemsSource="{x:Bind Tags}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                            <Border Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                    CornerRadius="3">
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           Text="{x:Bind KindText}" />
                                                            </Border>
                                                            <Border Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                                    CornerRadius="3"
                                                                    Visibility="{x:Bind MissingDllVisibility}">
                                                                <TextBlock FontSize="11" Text="文件不见了" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Text="{x:Bind SummaryText}" />
                                                    </Grid>
                                                </Button>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <ToggleSwitch MinWidth="0"
                                                                  VerticalAlignment="Center"
                                                                  IsOn="{x:Bind GloballyEnabled, Mode=TwoWay}"
                                                                  OffContent="全局关"
                                                                  OnContent="全局开"
                                                                  ToolTipService.ToolTip="全局开关；关掉的话哪个游戏都用不了这个模块" />
                                                    <Button Click="Button_CheckModuleUpdate_Click" Content="检查更新" />
                                                    <Button Click="Button_OpenModuleFolder_Click"
                                                            Content="打开目录"
                                                            Style="{StaticResource CatalogRowButtonStyle}" />
                                                    <Button Click="Button_DeleteModule_Click"
                                                            Content="删除"
                                                            Style="{StaticResource CatalogRowButtonStyle}"
                                                            ToolTipService.ToolTip="真正删除模块文件（内置/远端目录模块删后可在可下载里重装）"
                                                            Visibility="{x:Bind DeleteVisibility}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Spacing="6" Visibility="{x:Bind ExpandedVisibility}">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind DetailText}"
                                                           TextWrapping="Wrap" />
                                                <HyperlinkButton Padding="0"
                                                                 Click="Hyperlink_Homepage_Click"
                                                                 Content="{x:Bind Homepage}"
                                                                 Visibility="{x:Bind HomepageVisibility}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TextBlock_ModulesCurrentEmpty"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="还没有装任何模块。先在下面「可下载」里拉一个，或「添加 DLL…」"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <TextBlock Margin="0,6,0,0"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Text="可下载" />

                        <ItemsControl x:Name="ModuleDownloadList" ItemsSource="{x:Bind AvailableModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ModuleDownloadItemViewModel">
                                    <Border Style="{StaticResource CatalogCardStyle}">
                                        <StackPanel Spacing="6">
                                            <Button Style="{StaticResource CatalogHeaderButtonStyle}"
                                                    Click="Button_ModuleDownloadHeader_Click"
                                                    ToolTipService.ToolTip="点一下展开 / 收起">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                        <FontIcon VerticalAlignment="Center"
                                                                  FontSize="12"
                                                                  Glyph="{x:Bind ExpandGlyph}" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                   Text="{x:Bind Name}" />
                                                        <ItemsControl VerticalAlignment="Center"
                                                                      ItemTemplate="{StaticResource CatalogTagTemplate}"
                                                                      ItemsSource="{x:Bind Tags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Text="可下载" />
                                                </Grid>
                                            </Button>

                                            <StackPanel Spacing="6" Visibility="{x:Bind ExpandedVisibility}">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind DetailText}"
                                                           TextWrapping="Wrap" />
                                                <ComboBox MinWidth="200"
                                                          Header="版本"
                                                          HorizontalAlignment="Left"
                                                          ItemsSource="{x:Bind Versions}"
                                                          PlaceholderText="点开卡片时自动获取版本"
                                                          SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" />
                                                <Button HorizontalAlignment="Left"
                                                        Click="Button_DownloadModule_Click"
                                                        Content="下载 / 更新"
                                                        IsEnabled="{x:Bind CanInteract}"
                                                        Style="{ThemeResource AccentButtonStyle}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind StatusText}"
                                                           TextWrapping="Wrap" />
                                                <HyperlinkButton Padding="0"
                                                                 Click="Hyperlink_Homepage_Click"
                                                                 Content="{x:Bind LinkText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TextBlock_ModulesAvailableEmpty"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="目录里能装的模块都已经装上了。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  底部状态  -->
        <StackPanel Grid.Row="4" Spacing="4">
            <ProgressBar x:Name="ProgressBar_Overall"
                         Height="3"
                         Maximum="100"
                         Visibility="Collapsed" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TextBlock_Status"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap" />

                <!--  下载暂停 / 继续；只有在有下载任务时才出现  -->
                <Button x:Name="Button_PauseDownload"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="Button_PauseDownload_Click"
                        Content="暂停"
                        Visibility="Collapsed" />

                <!--  下载取消  -->
                <Button x:Name="Button_CancelDownload"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="Button_CancelDownload_Click"
                        Content="取消"
                        Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </Grid>

</sf:PageBase>
