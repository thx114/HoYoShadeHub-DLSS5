<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Plugins.DllConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:HoYoShadeHub.Features.Plugins"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Padding="18,4,30,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题 + 操作  -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="0">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DLL 配置" />
                <TextBlock x:Name="TextBlock_TargetPath"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="正在检测 HoYoShade…"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!--  运行时齐了：常驻绿字挂在标题右侧（以前是常驻 InfoBar，占一整行）  -->
            <TextBlock x:Name="TextBlock_RuntimeOk"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Text="运行时齐全"
                       Visibility="Collapsed" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Click="Button_ImportNr_Click" Content="导入 NR" />
                <Button x:Name="Button_FixDlss5"
                        Click="Button_FixDlss5_Click"
                        Content="安装必要组件"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="缺什么装什么：DLSS5 神经渲染运行时（nvngx_dlssnr.dll）+ Streamline" />
                <Button Click="Button_Refresh_Click" Content="检查更新" />
                <Button Content="更多">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="Button_ConsolidateNr_Click" Text="整理 NR 硬链接" />
                            <MenuFlyoutItem Click="Button_PickFolder_Click" Text="指定目录" />
                            <MenuFlyoutItem Click="Button_OpenFolder_Click" Text="打开目录" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="InfoBar_Status"
                 Grid.Row="1"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Informational" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="340" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="DLL 清单" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled">
                        <StackPanel Spacing="4">
                            <ItemsControl x:Name="ItemsControl_Families" ItemsSource="{x:Bind Families}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DllFamilyViewModel">
                                        <StackPanel Padding="0,4" Spacing="3">
                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ComboBox MinWidth="0" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Versions}" SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" ToolTipService.ToolTip="选择 DLL 版本" />
                                                <Button Grid.Column="1" Padding="8,4" Click="Button_InstallDll_Click" Content="切换" IsEnabled="{x:Bind CanInstall, Mode=OneWay}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:InstalledDllViewModel">
                                                        <Grid ColumnSpacing="4" Padding="0,1">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" ToolTipService.ToolTip="{x:Bind VersionText}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{x:Bind OtherInstalled}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:InstalledDllViewModel">
                                        <TextBlock Margin="0,1" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" ToolTipService.ToolTip="{x:Bind VersionText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="NR 版本库" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsControl_NrVersions" ItemsSource="{x:Bind NrVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:NrVersionCardViewModel">
                                <StackPanel>
                                <TextBlock Text="可下载" Margin="0,8,0,8" Style="{ThemeResource BodyStrongTextBlockStyle}" Visibility="{x:Bind DownloadHeadingVisibility}" />
                                <Border Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Background="{x:Bind BarBrush}" CornerRadius="3,0,0,3" />
                                        <Grid Grid.Column="1" Margin="0,8,12,8" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Version}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind StatusText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="4" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="Button_DownloadNr_Click" ToolTipService.ToolTip="{x:Bind DownloadText}" AutomationProperties.Name="{x:Bind DownloadText}" Visibility="{x:Bind DownloadVisibility}">
                                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                                </Button>
                                                <Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="4" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="Button_CheckNrUpdate_Click" ToolTipService.ToolTip="检查更新" AutomationProperties.Name="检查更新" Visibility="{x:Bind InstalledActionsVisibility}">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                </Button>
                                                <Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="4" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="Button_OpenNr_Click" ToolTipService.ToolTip="打开目录" AutomationProperties.Name="打开目录" IsEnabled="{x:Bind IsInstalled}" Visibility="{x:Bind InstalledActionsVisibility}">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                </Button>
                                                <ToggleSwitch Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="0" IsOn="{x:Bind IsAvailable}" IsEnabled="{x:Bind IsInstalled}" OnContent="" OffContent="" ToolTipService.ToolTip="控制此版本是否在 OPT 和插件页的 NR 选择器中出现；不更改已有游戏选择" Toggled="Toggle_NrGlobal_Toggled" Visibility="{x:Bind InstalledActionsVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="4">
            <ProgressBar x:Name="ProgressBar_Overall"
                         Height="3"
                         Maximum="100"
                         Visibility="Collapsed" />
            <TextBlock x:Name="TextBlock_Status"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>

</sf:PageBase>
