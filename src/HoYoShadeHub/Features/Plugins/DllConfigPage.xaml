<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Plugins.DllConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:HoYoShadeHub.Features.Plugins"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Padding="36,4,36,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题 + 操作  -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="0">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DLL 配置" />
                <TextBlock x:Name="TextBlock_TargetPath"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="正在检测 HoYoShade…"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="Button_FixDlss5"
                        Click="Button_FixDlss5_Click"
                        Content="安装必要组件"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="缺什么装什么：DLSS5 神经渲染运行时（nvngx_dlssnr.dll）+ Streamline" />
                <Button x:Name="Button_Refresh" Click="Button_Refresh_Click" ToolTipService.ToolTip="重新检测">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                <Button x:Name="Button_PickFolder" Click="Button_PickFolder_Click" Content="指定目录" />
                <Button x:Name="Button_OpenFolder" Click="Button_OpenFolder_Click" Content="打开目录" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="InfoBar_Status"
                 Grid.Row="1"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Informational" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左：现在装了什么  -->
            <Border Grid.Column="0"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="插件目录里现有的 DLL" />

                    <ListView x:Name="InstalledList" Grid.Row="1" Padding="0" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:InstalledDllViewModel">
                                <Grid Margin="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind FileName, Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind VersionText, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind SizeText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="TextBlock_InstalledEmpty"
                               Grid.Row="1"
                               Margin="0,12,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="这个目录里还没有 dll。"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!--  右：可下载的组件  -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Grid.RowSpan="2">
                    <ItemsControl ItemsSource="{x:Bind Families}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DllFamilyViewModel">
                                <Border Margin="0,0,0,8"
                                        Padding="14,10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                                            <Border Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                    CornerRadius="3"
                                                    Visibility="{x:Bind RequiredBadgeVisibility, Mode=OneWay}">
                                                <TextBlock FontSize="11" Text="DLSS5 必需" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind Note, Mode=OneWay}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind InstalledText, Mode=OneWay}"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox MinWidth="200"
                                                      ItemsSource="{x:Bind Versions, Mode=OneWay}"
                                                      SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}"
                                                      ToolTipService.ToolTip="选一个版本；括号里是备注" />
                                            <Button Click="Button_InstallDll_Click"
                                                    Content="安装"
                                                    IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                                                    Style="{ThemeResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="4">
            <ProgressBar x:Name="ProgressBar_Overall"
                         Height="3"
                         Maximum="100"
                         Visibility="Collapsed" />
            <TextBlock x:Name="TextBlock_Status"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>

</sf:PageBase>
