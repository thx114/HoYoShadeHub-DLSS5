<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="HoYoShadeHub.Features.Plugins.Dlss5CompatDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:HoYoShadeHub.Features.Plugins"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CloseButtonText="关闭"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>

    <Grid Width="900" Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题 + 概览 + 重新检测  -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock FontSize="20"
                           FontWeight="Bold"
                           Text="DLSS5 兼容性检测" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="{x:Bind TargetText, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TextBlock_Summary"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Text="正在检测" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="Button_Recheck"
                        Click="Button_Recheck_Click"
                        Content="重新检测"
                        IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}" />
                <Button x:Name="Button_FixAll"
                        Click="Button_FixAll_Click"
                        Content="一键修复全部"
                        IsEnabled="{x:Bind CanFixAll, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="按 715 的顺序把所有能自动修的问题修一遍（第三方 dll 走「移到备份」而不是删除）" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="InfoBar_Status"
                 Grid.Row="1"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Informational" />

        <!--  20 条结果  -->
        <ScrollViewer Grid.Row="2" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{x:Bind Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:Dlss5CompatItem">
                        <Border Margin="0,0,0,6"
                                Padding="12,9"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  状态图标  -->
                                <FontIcon Grid.Column="0"
                                          VerticalAlignment="Top"
                                          FontSize="14"
                                          Foreground="{x:Bind StatusBrush}"
                                          Glyph="{x:Bind StatusGlyph}" />

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind HeaderText}" />
                                        <Border Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="3">
                                            <TextBlock FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind GroupText}" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{x:Bind StatusBrush}"
                                                   Text="{x:Bind StatusText}" />
                                    </StackPanel>

                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind Message, Mode=OneWay}"
                                               TextWrapping="Wrap" />

                                    <TextBlock x:Name="TextBlock_FixResult"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind FixResult, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind FixResultVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <!--  修复按钮  -->
                                <Button Grid.Column="2"
                                        MinWidth="0"
                                        VerticalAlignment="Top"
                                        Click="Button_Fix_Click"
                                        Content="{x:Bind FixLabel, Mode=OneWay}"
                                        Visibility="{x:Bind FixVisibility, Mode=OneWay}" />

                                <ProgressRing Grid.Column="2"
                                              Width="20"
                                              Height="20"
                                              VerticalAlignment="Top"
                                              IsActive="{x:Bind IsFixing, Mode=OneWay}"
                                              Visibility="{x:Bind FixingVisibility, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Text=" 检测只读不写盘；只有点「修复」才会动文件。第三方 dll / 链接是「移到备份目录」而不是删除。"
                   TextWrapping="Wrap" />
    </Grid>
</ContentDialog>
