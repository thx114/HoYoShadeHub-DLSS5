<?xml version="1.0" encoding="utf-8"?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Plugins.GamePluginPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:local="using:HoYoShadeHub.Features.Plugins"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:sf="using:HoYoShadeHub.Frameworks"
            x:DefaultBindMode="OneWay"
            mc:Ignorable="d">

    <Grid Padding="18,8,30,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题 + 操作。切游戏用**上面那行游戏列表**，这里不重复放一份  -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  「插件」标题右边紧跟 NV 驱动提示（用户要求：放右侧，不放下面）  -->
            <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Style="{ThemeResource TitleTextBlockStyle}" Text="插件" />
                    <!--  用 DLSS5 插件时检查 NVIDIA 驱动版本（用户要求的红/黄区间）  -->
                    <TextBlock x:Name="TextBlock_DriverWarning"
                              VerticalAlignment="Center"
                              Style="{ThemeResource CaptionTextBlockStyle}"
                              TextWrapping="Wrap"
                              Visibility="Collapsed" />
                </StackPanel>
                <!--  第 1 列：游戏名 - 主程序；第 2 列：插件目录  -->
                <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="TextBlock_GameMeta"
                              VerticalAlignment="Center"
                              Style="{ThemeResource CaptionTextBlockStyle}"
                              TextWrapping="Wrap" />
                    <TextBlock x:Name="TextBlock_TargetPath"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              Style="{ThemeResource CaptionTextBlockStyle}"
                              Text="正在检测 HoYoShade…"
                              TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!--  这份 ini 的 AddonPath 和当前 HoYoShade 不一致时提示（红黄标是按这个游戏的目录算的）  -->
                <TextBlock x:Name="TextBlock_PathHint"
                          Margin="0,4,0,0"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          Style="{ThemeResource CaptionTextBlockStyle}"
                          TextWrapping="Wrap"
                          Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="Button_Refresh" Click="Button_Refresh_Click" ToolTipService.ToolTip="重新检测">
                    <FontIcon FontSize="14" Glyph="" />
                </Button>
                <Button x:Name="Button_AlignIni"
                       Click="Button_AlignIni_Click"
                       Content="指回当前 HoYoShade"
                       Visibility="Collapsed"
                       ToolTipService.ToolTip="把这份 ReShade.ini 里的绝对路径（AddonPath / EffectSearchPaths / PresetPath / 字体 / 截图目录）改成当前这个 HoYoShade 的；用哪个启动器，ini 就对应到哪。游戏用专属插件目录（每游戏插件包）时不会动 AddonPath —— 那是正常状态" />
                <Button x:Name="Button_PickExe"
                       Click="Button_PickExe_Click"
                       Content="指定主程序…"
                       ToolTipService.ToolTip="目录里有多个 exe 时，挑出真正的游戏主程序；进程名和 ReShade.ini 位置都靠它" />
                <Button x:Name="Button_Dlss5CompatCheck"
                       Click="Button_Dlss5CompatCheck_Click"
                       Content="DLSS5 兼容性检测"
                       Style="{ThemeResource AccentButtonStyle}"
                       ToolTipService.ToolTip="检测这台机器 / 这个游戏跑 DLSS5 神经渲染的 20 项兼容性，并提供一键修复" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="InfoBar_Status" Grid.Row="1" IsClosable="True" IsOpen="False" Severity="Informational" />

        <!--  左：这个游戏的插件列表 ；右：插件配置栏  -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListView x:Name="AddonList" Padding="0" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AddonItemViewModel">
                            <Border Margin="0,0,0,8"
                                   Padding="14,10"
                                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                   BorderThickness="1"
                                   CornerRadius="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4" Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Style="{ThemeResource CaptionTextBlockStyle}"
                                                      Text="{x:Bind VersionText, Mode=OneWay}"
                                                      Visibility="{x:Bind VersionVisibility, Mode=OneWay}" />
                                            <Border Padding="6,1"
                                                   VerticalAlignment="Center"
                                                   Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                   CornerRadius="3"
                                                   Visibility="{x:Bind GloballyDisabledVisibility, Mode=OneWay}">
                                                <TextBlock FontSize="11" Text="全局已禁用" />
                                            </Border>
                                            <!--  缺 DLSS5 运行时：红 = 起不来，黄 = 可能不出画面  -->
                                            <Border Padding="6,1"
                                                   VerticalAlignment="Center"
                                                   Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                   CornerRadius="3"
                                                   Visibility="{x:Bind DllRequiredVisibility, Mode=OneWay}">
                                                <TextBlock FontSize="11" Text="{x:Bind DllStatusText, Mode=OneWay}" />
                                            </Border>
                                            <Border Padding="6,1"
                                                   VerticalAlignment="Center"
                                                   Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                   CornerRadius="3"
                                                   Visibility="{x:Bind DllRecommendedVisibility, Mode=OneWay}">
                                                <TextBlock FontSize="11" Text="{x:Bind DllStatusText, Mode=OneWay}" />
                                            </Border>
                                            <!--  修复：缺件弹窗选版本（Streamline 默认 2.14.0.0 —— 新版包里没有 sl.interposer.dll）  -->
                                            <Button MinWidth="0"
                                                    Padding="8,2"
                                                    Click="Button_FixDll_Click"
                                                    Content="修复"
                                                    FontSize="11"
                                                    Visibility="{x:Bind HasMissingDllVisibility, Mode=OneWay}" />
                                        </StackPanel>

                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Style="{ThemeResource CaptionTextBlockStyle}"
                                                  Text="{x:Bind MetaText, Mode=OneWay}" />

                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Style="{ThemeResource CaptionTextBlockStyle}"
                                                  Text="{x:Bind FileName, Mode=OneWay}"
                                                  TextTrimming="CharacterEllipsis" />

                                        <!--  需求1：这个插件装了多个版本时，就在这张卡片里选这个游戏用哪一版。
                                             数据模板里不能挂 SelectionChanged，所以用 TwoWay 绑定 + setter 回调
                                             （和 OptiScaler 配置选择同款）。只有一个版本时不显示。  -->
                                        <StackPanel Orientation="Horizontal"
                                                   Spacing="8"
                                                   Visibility="{x:Bind VersionChoiceVisibility, Mode=OneWay}">
                                            <TextBlock VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Text="版本" />
                                            <ComboBox MinWidth="180"
                                                     ItemsSource="{x:Bind VersionOptions, Mode=OneWay}"
                                                     SelectedItem="{x:Bind SelectedVersionOption, Mode=TwoWay}"
                                                     ToolTipService.ToolTip="{x:Bind VersionChoiceHint, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  右侧：上面是启用开关；下面（和左边「版本」下拉同一行）贴最右是扩展 / 缩回按钮  -->
                                    <Grid Grid.Column="1" Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <ToggleSwitch Grid.Row="0"
                                                     MinWidth="0"
                                                     HorizontalAlignment="Right"
                                                     IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                     IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                     OffContent="禁用"
                                                     OnContent="启用" />

                                        <!--  需求3：展开 / 缩回，贴在这一格的右下角（和左边「版本」下拉同一行）。
                                              注意：按钮**内容**里不能挂 x:Bind（这条 SDK 的 XamlCompiler 会直接崩，试过
                                              FontIcon.Glyph 和 TextBlock.Text 都一样），所以拆成两个按钮、各自一个静态字形，
                                              用按钮自己的 Visibility 切换。  -->
                                        <Button Grid.Row="1"
                                               MinWidth="32"
                                               Padding="6,2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Click="Button_ExpandAddon_Click"
                                               Tag="{x:Bind}"
                                               ToolTipService.ToolTip="展开这个插件的专属配置"
                                               Visibility="{x:Bind ExpandButtonVisibility, Mode=OneWay}">
                                            <FontIcon FontSize="12" Glyph="" />
                                        </Button>

                                        <Button Grid.Row="1"
                                               MinWidth="32"
                                               Padding="6,2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Click="Button_ExpandAddon_Click"
                                               Tag="{x:Bind}"
                                               ToolTipService.ToolTip="缩回去"
                                               Visibility="{x:Bind CollapseButtonVisibility, Mode=OneWay}">
                                            <FontIcon FontSize="12" Glyph="" />
                                        </Button>
                                    </Grid>
                                    <!--  需求3/4：展开后的**专属配置**。收起状态就是上面那块（和以前一样高）  -->
                                    <StackPanel x:Name="AddonDedicatedConfig"
                                               Margin="0,4,0,0"
                                               Spacing="8"
                                               Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}"
                                               Grid.Row="1"
                                               Grid.ColumnSpan="2">
                                        <MenuFlyoutSeparator Margin="0,4,0,4" />

                                        <!--  DLSS5 Feed：开局那两个延迟（写 dlss5-feed.cfg）  -->
                                        <StackPanel Spacing="6" Visibility="{x:Bind FeedConfigVisibility, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="DLSS5 Feed 配置" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      Style="{ThemeResource CaptionTextBlockStyle}"
                                                      Text="开局等多少帧才创建 / 重建 NGX 特性。日志里那句「holding the feature (re)build for N frames」就是它 —— 调小接管更快，代价是刚开局的帧可能还没准备好。"
                                                      TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock VerticalAlignment="Center" Text="create_delay" />
                                                <NumberBox MinWidth="110"
                                                          Maximum="3600"
                                                          Minimum="0"
                                                          SmallChange="10"
                                                          SpinButtonPlacementMode="Compact"
                                                          ToolTipService.ToolTip="第一个 NGX 特性晚多少帧创建（出厂 60）"
                                                          Value="{x:Bind FeedCreateDelay, Mode=TwoWay}" />
                                                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="warmup_rebuild" />
                                                <NumberBox MinWidth="110"
                                                          Maximum="3600"
                                                          Minimum="0"
                                                          SmallChange="10"
                                                          SpinButtonPlacementMode="Compact"
                                                          ToolTipService.ToolTip="第几帧做一次预热重建（出厂 180）"
                                                          Value="{x:Bind FeedWarmupRebuild, Mode=TwoWay}" />
                                            </StackPanel>
                                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      Style="{ThemeResource CaptionTextBlockStyle}"
                                                      Text="{x:Bind FeedConfigPath, Mode=OneWay}"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTipService.ToolTip="{x:Bind FeedConfigPath, Mode=OneWay}" />
                                        </StackPanel>

                                        <!--  HookPoint：DLSS 写 [RENODX-DLSS]，DLSS5 写 [RenoDX.DLSS5] NRHookPoint  -->
                                        <StackPanel Orientation="Horizontal"
                                                   Spacing="8"
                                                   Visibility="{x:Bind HookPointConfigVisibility, Mode=OneWay}">
                                            <TextBlock VerticalAlignment="Center" Text="HookPoint" />
                                            <ComboBox MinWidth="140"
                                                     SelectedIndex="{x:Bind HookPoint, Mode=TwoWay}"
                                                     ToolTipService.ToolTip="0 = off。数字对应的阶段在游戏里 ReShade 覆盖层的 Hook Method 里看">
                                                <ComboBoxItem Content="off" />
                                                <ComboBoxItem Content="1" />
                                                <ComboBoxItem Content="2" />
                                                <ComboBoxItem Content="3" />
                                                <ComboBoxItem Content="4" />
                                            </ComboBox>
                                            <TextBlock VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      Style="{ThemeResource CaptionTextBlockStyle}"
                                                      Text="{x:Bind HookPointKeyHint, Mode=OneWay}" />
                                        </StackPanel>

                                        <!--  DX11Source：RenoDX DLSS5 的「呈现模式」要求 [RenoDX.DLSS5] DX11Source=native；
                                              只有 DLSS5 主插件显示（旧 RenoDX DLSS 插件没这个键）。开 = 写 native，关 = 删键回默认。  -->
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                   Visibility="{x:Bind Dx11SourceVisibility, Mode=OneWay}">
                                            <TextBlock VerticalAlignment="Center" Text="DX11Source" />
                                            <ComboBox MinWidth="170"
                                                     SelectedIndex="{x:Bind Dx11Source, Mode=TwoWay}"
                                                     IsEnabled="{x:Bind CanEditDx11Source, Mode=OneWay}"
                                                     ToolTipService.ToolTip="RenoDX DLSS5 的呈现源。默认（不写键）= 跟随插件；native = 呈现模式要的；foreign = 外部源。重启游戏生效">
                                                <ComboBoxItem Content="默认（不写键）" />
                                                <ComboBoxItem Content="native（呈现模式）" />
                                                <ComboBoxItem Content="foreign" />
                                            </ComboBox>
                                        </StackPanel>

                                        <!--  EnableHooks：游戏完全走 NVIDIA Streamline、addon 弹「NR 需要 Streamline 设置」时
                                              勾这个（写 [RenoDX.DLSS5] EnableHooks=1，重启游戏）。同样只有 DLSS5 主插件显示。  -->
                                        <CheckBox Content="EnableHooks=1（Streamline 挂钩）"
                                                 IsChecked="{x:Bind EnableHooks, Mode=TwoWay}"
                                                 IsEnabled="{x:Bind CanEditEnableHooks, Mode=OneWay}"
                                                 ToolTipService.ToolTip="游戏完全走 NVIDIA Streamline、插件提示「NR 需要 Streamline 设置 / 请在 [RenoDX.DLSS5] 设置 EnableHooks=1」时勾上；取消 = 删键回默认。重启游戏生效"
                                                 Visibility="{x:Bind EnableHooksVisibility, Mode=OneWay}" />

                                        <!--  需求4：LoadFromDllMain 属于专属配置，搬进展开区（RenoDX DLSS 也补上了）  -->
                                        <CheckBox Content="LoadFromDllMain"
                                                 IsChecked="{x:Bind LoadFromDllMain, Mode=TwoWay}"
                                                 IsEnabled="{x:Bind CanEditLoadFromDllMain, Mode=OneWay}"
                                                 ToolTipService.ToolTip="这类插件要在 DllMain 阶段就加载；空槽位会原样保留。关闭插件会自动摘掉，重新启用会再补上"
                                                 Visibility="{x:Bind LoadFromDllMainVisibility, Mode=OneWay}" />

                                        <!--  「永远 off」：每次启动/注入前把 [RENODX-DLSS] 挂钩点写成 0（按游戏记）。
                                              只有旧 RenoDX DLSS 卡片有 —— DLSS5 走 Streamline，不吃这个键。  -->
                                        <CheckBox Content="启动游戏时强制 off（永远 off）"
                                                 IsChecked="{x:Bind ForceHookOffOnLaunch, Mode=TwoWay}"
                                                 IsEnabled="{x:Bind CanEditForceHookOff, Mode=OneWay}"
                                                 ToolTipService.ToolTip="每次从这里启动/注入游戏之前，自动把 [RENODX-DLSS] DirectNeuralRenderingHookPoint 写成 0（免得忘了改回来导致游戏起不来）"
                                                 Visibility="{x:Bind ForceHookOffVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="TextBlock_AddonsEmpty"
                          MaxWidth="460"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Text="这个游戏还没有可管理的插件。"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          Visibility="Collapsed" />
            </Grid>

            <!--  配置栏  -->
            <Border Grid.Column="1"
                   Padding="16"
                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                   BorderThickness="1"
                   CornerRadius="4">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="TextBlock_GameTitle"
                                  Style="{ThemeResource SubtitleTextBlockStyle}"
                                  Text="未选择游戏"
                                  TextWrapping="Wrap" />
                        <!--  「N 个插件，启用 M 个」：原来在页面最底部，现在提到这儿（配置栏第一屏）  -->
                        <TextBlock x:Name="TextBlock_AddonSummary"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Style="{ThemeResource CaptionTextBlockStyle}"
                                  TextWrapping="Wrap"
                                  Visibility="Collapsed" />

                        <MenuFlyoutSeparator Margin="0,4,0,0" />

                        <!--  注入时机：HoYoShade / ReShade 注入那一步的等待时间（按游戏）  -->
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="注入时机" />
                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  Style="{ThemeResource CaptionTextBlockStyle}"
                                  Text="越早注入越省事，但游戏刚启动就注可能把它带崩；默认 0 秒（立即注入，和以前一样），调大才会等。"
                                  TextWrapping="Wrap" />
                        <NumberBox x:Name="NumberBox_ShadeInjectDelay"
                                  MinWidth="160"
                                  Minimum="0"
                                  Maximum="30"
                                  SmallChange="1"
                                  SpinButtonPlacementMode="Compact"
                                  PlaceholderText="跟随全局"
                                  ValueChanged="NumberBox_ShadeInjectDelay_ValueChanged"
                                  ToolTipService.ToolTip="HoYoShade / ReShade 注入前等几秒。0 = 立即；留空 = 跟随全局默认（设置对话框里的「默认注入时机」）。只影响这一个游戏。" />

                        <MenuFlyoutSeparator Margin="0,4,0,0" />

                        <!--  ReShade.ini 工具  -->
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="ReShade.ini" />
                        <TextBlock x:Name="TextBlock_IniPath"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  Style="{ThemeResource CaptionTextBlockStyle}"
                                  TextWrapping="Wrap" />
                        <Button x:Name="Button_BuildIni"
                               HorizontalAlignment="Stretch"
                               Click="Button_BuildIni_Click"
                               Content="重置模板 ReShade.ini"
                               ToolTipService.ToolTip="跑 HoYoShade\LauncherResource\INIBuild.exe 重新生成模板（等于 bat 里的重置 ReShade.ini）" />
                        <Button x:Name="Button_CopyIni"
                               HorizontalAlignment="Stretch"
                               Click="Button_CopyIni_Click"
                               Content="复制模板到游戏目录"
                               ToolTipService.ToolTip="游戏目录里没有 ReShade.ini 时，手动补一份（HoYoShade 自己会在注入时复制）" />
                        <Button x:Name="Button_OpenGameFolder"
                               HorizontalAlignment="Stretch"
                               Click="Button_OpenGameFolder_Click"
                               Content="打开游戏目录" />
                        <Button x:Name="Button_OpenAddonFolder"
                               HorizontalAlignment="Stretch"
                               Click="Button_OpenAddonFolder_Click"
                               Content="打开插件目录" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  底部状态栏（用户要求移除，给插件卡片列表留满高度）：控件保留 Collapsed，
              代码里几十处 TextBlock_Status 写入不用动；Row 3 高度随之归零  -->
        <TextBlock x:Name="TextBlock_Status"
                  Grid.Row="3"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{ThemeResource CaptionTextBlockStyle}"
                  TextWrapping="Wrap"
                  Visibility="Collapsed" />
    </Grid>

</sf:PageBase>
