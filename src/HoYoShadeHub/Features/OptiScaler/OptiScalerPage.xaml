<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.OptiScaler.OptiScalerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:HoYoShadeHub.Features.OptiScaler"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Padding="18,4,30,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="OptiScaler" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="TextBlock_Game"
                       VerticalAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Button Click="Button_Refresh_Click" Content="刷新" />
            <Button Click="Button_OpenLibrary_Click" Content="打开 OptiScaler 目录" />
            <Button Click="Button_OpenPresetFolder_Click" Content="配置目录" />
            <!--  注入用的 DLL 文件名（游戏会按名字认代理 dll）。默认 OptiScaler，最下面「自定义」可选其它名字  -->
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="DLL 名称" />
            <ComboBox x:Name="ComboBox_DllName"
                      MinWidth="140"
                      SelectionChanged="ComboBox_DllName_SelectionChanged" />
            <TextBox x:Name="TextBox_CustomDllName"
                     MinWidth="140"
                     PlaceholderText="xxx.dll"
                     TextChanged="TextBox_CustomDllName_TextChanged"
                     Visibility="Collapsed" />
            <!--  注入时机（OptiScaler，按游戏）：越早注入越省事，但游戏刚启动就注可能把它带崩；默认 0 秒（立即注入，和以前一样）  -->
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="注入时机" />
            <NumberBox x:Name="NumberBox_OptiInjectDelay"
                       Width="150"
                       Minimum="0"
                       Maximum="30"
                       SmallChange="1"
                       SpinButtonPlacementMode="Compact"
                       PlaceholderText="跟随全局"
                       ValueChanged="NumberBox_OptiInjectDelay_ValueChanged"
                       ToolTipService.ToolTip="OptiScaler 注入前等游戏稳定几秒。0 = 立即；留空 = 跟随全局默认。只影响这一个游戏。" />
            <TextBlock x:Name="TextBlock_Count"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--  第 2 条修回：**一个构建一张卡片，点一下就是单选**
              （用户：以前是多个 opt 单选、点卡片就换；被改成「卡片里一个切换版本下拉」之后卡片点不动了）。
              一个来源装了多版时，每版单独一张卡，标题里带版本号区分。  -->
        <!--  ItemsControl 没有内置滚动，所以用 ScrollViewer 包住（工具栏/标题固定，只有列表滚）  -->
        <ScrollViewer Grid.Row="2" Padding="0,0,6,0">
            <ItemsControl x:Name="OptiScalerSourceList">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:OptiScalerBuildItemViewModel">
                    <Border Margin="0,0,0,6"
                            Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="Card_Tapped"
                            ToolTipService.ToolTip="点一下：这个游戏改用这一版（同一时间只有一个「使用中」）">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  单选圈：只显示状态，不吃点击（点击交给整张卡片）  -->
                        <RadioButton Grid.Column="0"
                                     MinWidth="0"
                                     Padding="0,0,4,0"
                                     VerticalAlignment="Center"
                                     GroupName="OptiScalerBuild"
                                     IsChecked="{x:Bind IsInUse, Mode=OneWay}"
                                     IsHitTestVisible="False" />

                        <StackPanel Grid.Column="1" Spacing="6">
                            <!--  第一行：来源 + 版本 + 标签 + 「使用中」  -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind Title, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="3"
                                        Visibility="{x:Bind InUseVisibility, Mode=OneWay}">
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                               Text="使用中" />
                                </Border>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind TagsText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="这个包里没有 OptiScaler.dll"
                                           Visibility="{x:Bind DllMissingVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <!--  第二行：这一版装在哪 / 注入哪个文件  -->
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Text="{x:Bind Detail, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <!--  第三行：当前配置  -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="当前配置：" />
                                <ComboBox MinWidth="160"
                                          ItemsSource="{x:Bind PresetOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind CurrentPreset, Mode=TwoWay}" />
                                <Button Padding="8,2" Click="Button_PresetAdd_Click" ToolTipService.ToolTip="新增配置（空配置 / 复制现有 / 从网络下载）">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                </Button>
                                <Button Padding="8,2" Click="Button_PresetOpenFile_Click" ToolTipService.ToolTip="修改：用编辑器打开这份配置">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                </Button>
                                <Button Padding="10,2" Click="Button_PresetRename_Click" Content="重命名" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind CurrentProfileText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="TextBlock_Status"
                   Grid.Row="3"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>

</sf:PageBase>
