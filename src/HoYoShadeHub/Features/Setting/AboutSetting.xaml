<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.Setting.AboutSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cw="using:CommunityToolkit.WinUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:HoYoShadeHub.Language"
             xmlns:local="using:HoYoShadeHub.Features.Setting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:HoYoShadeHub.Models"
             xmlns:s="using:HoYoShadeHub"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Page.Resources>
        <cw:AttachedDropShadow x:Key="LogoShadow"
                               CastTo="{x:Bind Border_LogoShadow}"
                               Opacity="0.4"
                               Offset="4" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="0,0,0,20">

            <!--  Logo  -->
            <Grid>
                <Border Name="Border_LogoShadow" />
                <Image Width="120"
                       Height="120"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       cw:Effects.Shadow="{StaticResource LogoShadow}"
                       Source="ms-appx:///Assets/logo.png" />
            </Grid>

            <TextBlock Margin="0,24,0,0"
                       FontSize="24"
                       FontWeight="Bold"
                       Text="HoYoShade Hub" />
            <TextBlock Margin="0,4,0,0" Text="Developed by HoYoShade Hub Team, all rights reserved." />


            <!--  当前版本  -->
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.SettingPage_CurrentVersion}" />
                <TextBlock FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           Text="{x:Bind s:AppConfig.AppVersion}" />
            </StackPanel>



            <ToggleSwitch Margin="0,8,0,0"
                          IsOn="{x:Bind AutoCheckLauncherUpdateOnStartup, Mode=TwoWay}"
                          OffContent="{x:Bind AutoCheckUpdatesText, Mode=OneWay}"
                          OnContent="{x:Bind AutoCheckUpdatesText, Mode=OneWay}" />
            
            <!--  下载服务器选择  -->
            <TextBlock Margin="0,12,0,4"
                       Text="{x:Bind lang:Lang.HoYoShadeDownloadView_DownloadServer}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox MinWidth="240"
                      HorizontalAlignment="Left"
                      ItemsSource="{x:Bind DownloadServers}"
                      SelectedItem="{x:Bind SelectedDownloadServer, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadServerItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Border Grid.Column="1" 
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                     BorderThickness="1"
                                     CornerRadius="4" 
                                     Padding="6,2" 
                                     VerticalAlignment="Center"
                                     Visibility="{x:Bind LatencyText, Mode=OneWay, Converter={StaticResource WhiteSpaceStringToVisibilityConverter}}">
                                 <TextBlock Text="{x:Bind LatencyText, Mode=OneWay}" Foreground="{x:Bind LatencyColor, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" UseLayoutRounding="True" />
                             </Border>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <!--  GitHub 渠道：版本列表（比当前旧的就是退回）+ 一键安装  -->
            <StackPanel Margin="0,8,0,0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox MinWidth="260"
                              Header="版本"
                              DropDownOpened="ComboBox_GithubVersions_DropDownOpened"
                              ItemsSource="{x:Bind GithubVersions, Mode=OneWay}"
                              PlaceholderText="点开自动获取"
                              SelectedItem="{x:Bind SelectedGithubVersion, Mode=TwoWay}" />
                    <Button Height="40"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind InstallGithubVersionCommand}"
                            Content="下载并安装（选旧的即退回）"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <ProgressBar Height="4"
                             Maximum="100"
                             Value="{x:Bind GithubProgress, Mode=OneWay}"
                             Visibility="{x:Bind IsGithubProgressVisible, Mode=OneWay}" />

                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind GithubStatusText, Mode=OneWay}"
                           TextWrapping="Wrap" />

                <Button Command="{x:Bind RestartAfterGithubUpdateCommand}"
                        Content="重启生效"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind IsGithubRestartVisible, Mode=OneWay}" />
            </StackPanel>


            <!--  远端目录（插件 + OptiScaler）：平时每天自动拉一次，这里是手动拉  -->
            <Grid Margin="0,12,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Height="40"
                        Padding="12,0,16,0"
                        BorderThickness="0"
                        Command="{x:Bind RefreshCatalogCommand}"
                        CornerRadius="4"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="从 GitHub 上的远端目录拉最新插件清单 / OptiScaler 来源（平时每天最多自动拉一次）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" />
                        <TextBlock Text="拉取插件目录" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ProgressRing Width="20"
                                  Height="20"
                                  IsIndeterminate="{x:Bind RefreshCatalogCommand.IsRunning}"
                                  Visibility="{x:Bind RefreshCatalogCommand.IsRunning}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind CatalogRefreshText, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>


            <!--  实验性功能：插件汉化（入口从插件页挪过来；默认不宣传）  -->
            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="实验性功能" />
            <Grid Margin="0,12,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Height="40"
                        Padding="12,0,16,0"
                        BorderThickness="0"
                        Click="Button_LocalizeAllAddons_Click"
                        CornerRadius="4"
                        ToolTipService.ToolTip="【实验性】把各个 HoYoShade 目录里的插件（addon64）按内置翻译表原地改成中文；改之前自动备份，再点一次会先还原重打，随时可以还原成原版。重启游戏生效。">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C1;" />
                        <TextBlock Text="汉化插件（实验性）" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ProgressRing Width="20"
                                  Height="20"
                                  IsIndeterminate="{x:Bind IsLocalizingAddons, Mode=OneWay}"
                                  Visibility="{x:Bind IsLocalizingAddons, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind AddonLocalizeText, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!--  相关链接  -->
            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.AboutSettingPage_Links}" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/DuolaD/HoYoShade-Hub" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_ProjectHomepage}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/DuolaD/HoYoShade-Hub/issues" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_ReportIssue}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/DuolaD/HoYoShade-Hub/releases" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_ReleaseHistroy}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://hoyosha.de/user-agreement.html" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_PrivacyPolicy}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/DuolaD/" UnderlineStyle="None">
                    <Run FontWeight="Bold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                         Text="{x:Bind lang:Lang.SettingPage_Donate}" />
                </Hyperlink>
            </TextBlock>





        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
