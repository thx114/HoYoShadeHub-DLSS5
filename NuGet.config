<?xml version="1.0" encoding="utf-8"?>
<!--
  本仓库显式声明 NuGet 源。

  原因：Visual Studio 会在机器级写入
    C:\Program Files (x86)\NuGet\Config\Microsoft.VisualStudio.FallbackLocation.config
  指向 C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages。
  没装 VS 的机器上这个目录不存在，NuGet 会直接以 NU1301 报错，restore 全挂。
  这里 <clear/> 掉继承来的源和回退目录，保证在干净机器 / CI 上也能 restore。
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
